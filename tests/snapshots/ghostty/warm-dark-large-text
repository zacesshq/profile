# written by zprf; change the profile and render again rather than editing this file
# load it from the main config with: config-file = <path to this file>

palette = 0=#1b1612
palette = 1=#ff7d6c
palette = 2=#57b84e
palette = 3=#b9a400
palette = 4=#71a3ff
palette = 5=#e280e0
palette = 6=#00b6b6
palette = 7=#bbbbbb
palette = 8=#a4a4a4
palette = 9=#ffa294
palette = 10=#6fd066
palette = 11=#d2bb00
