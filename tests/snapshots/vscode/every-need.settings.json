  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "name": "added",
        "scope": ["markup.inserted"],
        "settings": { "foreground": "#57bb5e", "fontStyle": "" }
      },
      {
        "name": "attribute",
        "scope": ["entity.other.attribute-name"],
        "settings": { "foreground": "#e19800", "fontStyle": "" }
      },
      {
        "name": "changed",
        "scope": ["markup.changed"],
        "settings": { "foreground": "#9accff", "fontStyle": "" }
      },
      {
        "name": "comment",
        "scope": ["comment", "punctuation.definition.comment"],
        "settings": { "foreground": "#8cb431", "fontStyle": "italic" }
      },
      {
        "name": "control",
        "scope": ["keyword.control"],
        "settings": { "foreground": "#ff95d2", "fontStyle": "bold" }
      },
      {
        "name": "function",
        "scope": ["entity.name.function", "support.function", "meta.function-call.generic"],
        "settings": { "foreground": "#66a9ff", "fontStyle": "" }
      },
      {
        "name": "invalid",
        "scope": ["invalid"],
        "settings": { "foreground": "#ffb4ae", "fontStyle": "underline" }
      },
      {
        "name": "keyword",
        "scope": ["keyword", "storage.type", "storage.modifier"],
        "settings": { "foreground": "#bb93ff", "fontStyle": "bold" }
      },
      {
        "name": "number",
        "scope": ["constant.numeric", "constant.language"],
        "settings": { "foreground": "#ffb69d", "fontStyle": "" }
      },
      {
        "name": "operator",
        "scope": ["keyword.operator", "punctuation"],
        "settings": { "foreground": "#ffffff", "fontStyle": "" }
      },
      {
        "name": "parameter",
        "scope": ["variable.parameter"],
        "settings": { "foreground": "#f68c36", "fontStyle": "italic" }
      },
      {
        "name": "property",
        "scope": ["variable.other.property", "variable.other.object.property", "support.type.property-name", "meta.object-literal.key"],
        "settings": { "foreground": "#bdc3ff", "fontStyle": "" }
      },
      {
        "name": "regex",
        "scope": ["string.regexp", "constant.character.escape"],
        "settings": { "foreground": "#ff7da0", "fontStyle": "" }
      },
      {
        "name": "removed",
        "scope": ["markup.deleted"],
        "settings": { "foreground": "#ff9c94", "fontStyle": "" }
      },
      {
        "name": "string",
        "scope": ["string"],
        "settings": { "foreground": "#68cc6e", "fontStyle": "" }
      },
      {
        "name": "tag",
        "scope": ["entity.name.tag"],
        "settings": { "foreground": "#bb93ff", "fontStyle": "bold" }
      },
      {
        "name": "type",
        "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
        "settings": { "foreground": "#2fcbc4", "fontStyle": "" }
      },
      {
        "name": "variable",
        "scope": ["variable", "variable.other.readwrite"],
        "settings": { "foreground": "#ffffff", "fontStyle": "" }
      }
    ]
  },
  "editor.fontFamily": "Atkinson Hyperlegible Mono",
  "terminal.integrated.fontFamily": "Atkinson Hyperlegible Mono",
  "editor.fontSize": 21,
  "terminal.integrated.fontSize": 21,
  "editor.lineHeight": 1.5,
  "terminal.integrated.lineHeight": 1.5,
  "editor.letterSpacing": 2.56,
  "terminal.integrated.letterSpacing": 2.56,
  "editor.rulers": [72],
  "workbench.reduceMotion": "on",
  "editor.cursorBlinking": "solid",
  "editor.cursorSmoothCaretAnimation": "off",
  "editor.smoothScrolling": false,
  "workbench.list.smoothScrolling": false,
  "terminal.integrated.smoothScrolling": false,
  "terminal.integrated.cursorBlinking": false,
  "workbench.editor.openSideBySideDirection": "down",
  "diffEditor.renderSideBySide": false,
  "editor.minimap.enabled": false,
  "editor.cursorStyle": "block",
  "editor.cursorWidth": 6,
  "terminal.integrated.minimumContrastRatio": 7.0
}
