  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "name": "added",
        "scope": ["markup.inserted"],
        "settings": { "foreground": "#5bbf62", "fontStyle": "" }
      },
      {
        "name": "attribute",
        "scope": ["entity.other.attribute-name"],
        "settings": { "foreground": "#e59b00", "fontStyle": "" }
      },
      {
        "name": "changed",
        "scope": ["markup.changed"],
        "settings": { "foreground": "#5dafff", "fontStyle": "" }
      },
      {
        "name": "comment",
        "scope": ["comment", "punctuation.definition.comment"],
        "settings": { "foreground": "#90b735", "fontStyle": "italic" }
      },
      {
        "name": "control",
        "scope": ["keyword.control"],
        "settings": { "foreground": "#f683c8", "fontStyle": "bold" }
      },
      {
        "name": "function",
        "scope": ["entity.name.function", "support.function", "meta.function-call.generic"],
        "settings": { "foreground": "#6badff", "fontStyle": "" }
      },
      {
        "name": "invalid",
        "scope": ["invalid"],
        "settings": { "foreground": "#ff877f", "fontStyle": "underline" }
      },
      {
        "name": "keyword",
        "scope": ["keyword", "storage.type", "storage.modifier"],
        "settings": { "foreground": "#be96ff", "fontStyle": "bold" }
      },
      {
        "name": "number",
        "scope": ["constant.numeric", "constant.language"],
        "settings": { "foreground": "#ff895f", "fontStyle": "" }
      },
      {
        "name": "operator",
        "scope": ["keyword.operator", "punctuation"],
        "settings": { "foreground": "#ffffff", "fontStyle": "" }
      },
      {
        "name": "parameter",
        "scope": ["variable.parameter"],
        "settings": { "foreground": "#f98f3a", "fontStyle": "italic" }
      },
      {
        "name": "property",
        "scope": ["variable.other.property", "variable.other.object.property", "support.type.property-name", "meta.object-literal.key"],
        "settings": { "foreground": "#9ca2ff", "fontStyle": "" }
      },
      {
        "name": "regex",
        "scope": ["string.regexp", "constant.character.escape"],
        "settings": { "foreground": "#ff83a3", "fontStyle": "" }
      },
      {
        "name": "removed",
        "scope": ["markup.deleted"],
        "settings": { "foreground": "#ff877f", "fontStyle": "" }
      },
      {
        "name": "string",
        "scope": ["string"],
        "settings": { "foreground": "#5bbf62", "fontStyle": "" }
      },
      {
        "name": "tag",
        "scope": ["entity.name.tag"],
        "settings": { "foreground": "#be96ff", "fontStyle": "bold" }
      },
      {
        "name": "type",
        "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
        "settings": { "foreground": "#00beb6", "fontStyle": "" }
      },
      {
        "name": "variable",
        "scope": ["variable", "variable.other.readwrite"],
        "settings": { "foreground": "#ffffff", "fontStyle": "" }
      }
    ]
  },
  "editor.fontFamily": "Atkinson Hyperlegible Mono",
  "terminal.integrated.fontFamily": "Atkinson Hyperlegible Mono",
  "editor.fontSize": 24,
  "terminal.integrated.fontSize": 24,
  "editor.lineHeight": 1.3,
  "terminal.integrated.lineHeight": 1.3,
  "editor.rulers": [80],
  "workbench.reduceMotion": "on",
  "editor.cursorBlinking": "solid",
  "editor.cursorSmoothCaretAnimation": "off",
  "editor.smoothScrolling": false,
  "workbench.list.smoothScrolling": false,
  "terminal.integrated.smoothScrolling": false,
  "terminal.integrated.cursorBlinking": false,
  "editor.cursorStyle": "block",
  "editor.cursorWidth": 4,
  "terminal.integrated.minimumContrastRatio": 7.0
}
