background = #101418
foreground = #ffffff
cursor-color = #dab600
cursor-text = #101418
selection-background = #b68cfa
selection-foreground = #101418

# Ghostty lifts any program's own colour pair to this ratio, so the profile's floor holds there too
minimum-contrast = 7.0
cursor-style = block
# shell integration turns the cursor back into a bar at every prompt unless told not to
shell-integration-features = no-cursor
cursor-style-blink = false
font-family = "Atkinson Hyperlegible Mono"
font-size = 16.0
adjust-cell-height = 50%
# a solid background, so text is never drawn over whatever sits behind the window
background-opacity = 1
background-blur = false
