{
  "name": "zacess-profile-extension",
  "version": "0.2.1",
  "private": true,
  "description": "Applies a Zacess Profile to every page through CSS custom properties",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node build.mjs",
    "test": "playwright test",
    "lint:firefox": "web-ext lint --source-dir dist/firefox",
    "store:screenshot": "node store/capture.mjs"
  },
  "dependencies": {
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/chrome": "0.3.7",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "web-ext": "10.8.0"
  }
}
