background = #1b1612
foreground = #ffffff
cursor-color = #debb00
cursor-text = #1b1612
selection-background = #b98ffd
selection-foreground = #1b1612

# Ghostty lifts any program's own colour pair to this ratio, so the profile's floor holds there too
minimum-contrast = 7.0
cursor-style = block
# shell integration turns the cursor back into a bar at every prompt unless told not to
shell-integration-features = no-cursor
cursor-style-blink = false
font-family = "Atkinson Hyperlegible Mono"
font-size = 18.0
adjust-cell-height = 30%
